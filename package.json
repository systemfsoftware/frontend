{
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@effect/tsgo": "catalog:",
    "@systemfsoftware/oxlint-config-recommended": "catalog:",
    "@systemfsoftware/oxlint-plugin-test-discipline": "catalog:",
    "@systemfsoftware/stryker-js": "catalog:",
    "@systemfsoftware/tsconfig": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "vitest": "catalog:",
    "lint-staged": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "tstyche-typescript": "npm:typescript@6.0.3",
    "typescript": "catalog:"
  },
  "license": "Apache-2.0",
  "name": "starter",
  "packageManager": "pnpm@12.9.0",
  "private": true,
  "scripts": {
    "attw": "sandbox -- turbo --concurrency=${TURBO_CONCURRENCY:-50%} attw",
    "bootstrap": "sandbox -- pnpm install && sandbox -- pnpm rebuild --config.ignore-scripts=false && sandbox -- pnpm run prepare",
    "build": "sandbox -- turbo --concurrency=${TURBO_CONCURRENCY:-50%} build",
    "dev": "sandbox --publish 1337:1337 -- pnpm --filter @endgame/site dev",
    "journeys": "sandbox --listen 1337 --pass-env PLAYWRIGHT_BROWSERS_PATH -- ./bin/journeys",
    "check:ci": "s=0; pnpm format:check || s=1; pnpm check:sfs-sources || s=1; TURBO_CONCURRENCY=${TURBO_CONCURRENCY:-100%} pnpm gate:tasks || s=1; pnpm gate:dist || s=1; pnpm test:sandbox || s=1; exit $s",
    "check:branch-rules": "sandbox --allow-host api.github.com --allow-host jsr.io --pass-env GITHUB_TOKEN --pass-env GITHUB_REPOSITORY -- ./scripts/check-branch-rules.ts",
    "check:sfs-sources": "sandbox --allow-host jsr.io -- ./scripts/check-sfs-sources.ts",
    "clean": "sandbox -- turbo clean",
    "check-env": "./bin/cloud pnpm --filter @endgame/site exec alchemy provider check-env --provider cloudflare",
    "deploy": "./bin/cloud pnpm --filter @endgame/site exec alchemy deploy --stage \"${ALCHEMY_STAGE:-prod}\" --no-input --yes",
    "destroy": "./bin/cloud pnpm --filter @endgame/site exec alchemy destroy --stage \"${ALCHEMY_STAGE:?set ALCHEMY_STAGE, e.g. pr-<N>}\" --no-input --yes",
    "format": "./bin/dprint fmt",
    "format:check": "./bin/dprint check",
    "gate:dist": "sandbox -- turbo --concurrency=${TURBO_CONCURRENCY:-100%} build attw",
    "gate:tasks": "sandbox --allow-host jsr.io --pass-env PLAYWRIGHT_BROWSERS_PATH --pass-env FONTCONFIG_FILE -- turbo --concurrency=${TURBO_CONCURRENCY:-50%} --continue lint lint:tsgo lint:suppressions typecheck typecheck:node test:types test test:browser test:scripts",
    "lint": "sandbox -- turbo --concurrency=${TURBO_CONCURRENCY:-50%} lint lint:tsgo lint:suppressions",
    "lint:suppressions": "./bin/sandboxed -- no-inline-suppression $(git ls-files -- '*.ts' '*.tsx' '*.mts' '*.cts' '*.js' '*.jsx' '*.mjs' '*.cjs' ':!:packages/oxlint-presets/oxlint-config-frontend/ui-state-fixture/src/react-effect/' ':!:packages/gherkin/storybook-gherkin/test/browser/scenario-title.deny.ts')",
    "precommit": "pnpm exec lint-staged --no-revert --config .lintstagedrc.js",
    "prepare": "effect-tsgo patch --oxlint --no-typescript --skip-missing",
    "test": "sandbox --allow-host jsr.io --pass-env PLAYWRIGHT_BROWSERS_PATH --pass-env FONTCONFIG_FILE -- turbo --concurrency=${TURBO_CONCURRENCY:-50%} test test:browser test:scripts && pnpm test:sandbox",
    "test:sandbox": "nix run .#sandbox-proofs && deno test --config=scripts/deno.json --allow-run=git,sandbox,sh --allow-env --allow-read --allow-write sandbox-proofs/",
    "typecheck": "sandbox -- turbo --concurrency=${TURBO_CONCURRENCY:-50%} --continue typecheck typecheck:node test:types",
    "typecheck:node": "./bin/sandboxed -- tsc -p tsconfig.node.json --noEmit",
    "test:scripts": "./bin/sandboxed --allow-host jsr.io -- deno test --config=scripts/deno.json --allow-read --allow-write --allow-import=jsr.io scripts/"
  },
  "type": "module"
}
