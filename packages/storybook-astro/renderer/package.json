{
  "name": "@systemfsoftware/storybook-astro-renderer",
  "license": "Apache-2.0",
  "version": "1.17.0",
  "author": "TODO <todo@example.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/frontend.git",
    "directory": "packages/storybook-astro/renderer"
  },
  "homepage": "https://github.com/systemfsoftware/frontend/tree/main/packages/storybook-astro/renderer#readme",
  "bugs": "https://github.com/systemfsoftware/frontend/issues",
  "description": "Client-side renderer for the Storybook Astro framework, forked under systemfsoftware from storybook-astro/storybook-astro.",
  "keywords": [
    "storybook",
    "astro",
    "vite"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.16.0 || >=22.19.0 || >=24.0.0"
  },
  "files": [
    "dist",
    "src",
    "types",
    "LICENSE",
    "NOTICE",
    "package.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/preset.d.ts",
      "import": "./dist/preset.js"
    },
    "./package.json": "./package.json",
    "./preset": {
      "types": "./dist/preset.d.ts",
      "import": "./dist/preset.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./entry-preview": {
      "types": "./types/entry-preview.d.ts",
      "default": "./dist/entry-preview.js"
    },
    "./entry-preview-docs": {
      "types": "./types/entry-preview-docs.d.ts",
      "default": "./dist/entry-preview-docs.js"
    },
    "./extractArgTypes": {
      "types": "./dist/extractArgTypes.d.ts",
      "import": "./dist/extractArgTypes.js"
    },
    "./preview-defaults": {
      "types": "./dist/preview-defaults.d.ts",
      "import": "./dist/preview-defaults.js"
    },
    "./decorators": {
      "types": "./dist/decorators.d.ts",
      "import": "./dist/decorators.js"
    },
    "./decoratedTree": {
      "types": "./dist/decoratedTree.d.ts",
      "import": "./dist/decoratedTree.js"
    },
    "./generateAstroSource": {
      "types": "./dist/docs/generateAstroSource.d.ts",
      "import": "./dist/docs/generateAstroSource.js"
    },
    "./slotArgs": {
      "types": "./dist/slotArgs.d.ts",
      "import": "./dist/slotArgs.js"
    },
    "./storyStyles": {
      "types": "./dist/storyStyles.d.ts",
      "import": "./dist/storyStyles.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown -l warn",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --config oxlint.config.ts --format=${f:-default}",
    "attw": "attw --pack ."
  },
  "dependencies": {
    "@types/node": "^20.19.0",
    "ts-dedent": "^2.2.0"
  },
  "peerDependencies": {
    "@storybook/react": "^10.0.0 || ^11.0.0-beta.0",
    "astro": "^5.5.3 || ^6.0.0 || ^7.0.0",
    "storybook": "^10.0.0 || ^11.0.0-beta.0"
  },
  "peerDependenciesMeta": {
    "@storybook/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/react": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "^4.2.0",
    "@systemfsoftware/oxlint-config-frontend": "workspace:^",
    "@systemfsoftware/tsdown-config": "^0.1.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "astro": "catalog:",
    "happy-dom": "catalog:",
    "oxlint": "catalog:oxlint",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rimraf": "catalog:",
    "storybook": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
