{
  "name": "@systemfsoftware/storybook-astro-framework",
  "license": "Apache-2.0",
  "version": "1.17.0",
  "author": "TODO <todo@example.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/frontend.git",
    "directory": "packages/storybook-astro/framework"
  },
  "homepage": "https://github.com/systemfsoftware/frontend/tree/main/packages/storybook-astro/framework#readme",
  "bugs": "https://github.com/systemfsoftware/frontend/issues",
  "description": "Storybook framework for Astro components, forked under systemfsoftware from storybook-astro/storybook-astro.",
  "keywords": [
    "storybook",
    "astro",
    "vite"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.16.0 || >=22.19.0 || >=24.0.0"
  },
  "files": [
    "dist",
    "src",
    "preset.ts",
    "package.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./integrations": {
      "types": "./dist/integrations/index.d.ts",
      "import": "./dist/integrations/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./vitest": {
      "types": "./dist/vitest/index.d.ts",
      "import": "./dist/vitest/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./docgen-worker": {
      "types": "./dist/docgen/docgen-worker.d.ts",
      "import": "./dist/docgen/docgen-worker.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "import": "./dist/preset.js"
    },
    "./image-service": {
      "types": "./dist/storybookImageService.d.ts",
      "default": "./dist/storybookImageService.js"
    },
    "./shim": {
      "types": "./src/shim.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown -l warn && node scripts/patch-shim-ref.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --config oxlint.config.ts --format=${f:-default}",
    "attw": "attw --pack ."
  },
  "dependencies": {
    "@systemfsoftware/storybook-astro-renderer": "workspace:*",
    "get-tsconfig": "5.0.0-beta.4",
    "hono": "catalog:",
    "sanitize-html": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@astrojs/alpinejs": "^0.4.5 || ^0.5.0 || ^1.0.0",
