    "@preact/preset-vite": "^2.10.1",
    "@storybook/preact": "^10.0.0 || ^11.0.0-beta.0",
    "@storybook/react": "^10.0.0 || ^11.0.0-beta.0",
    "@storybook/svelte": "^10.0.0 || ^11.0.0-beta.0",
    "@storybook/vue3": "^10.0.0 || ^11.0.0-beta.0",
    "@vitejs/plugin-react": "^5.0.0 || ^6.0.0",
    "@vitejs/plugin-vue": "^5.2.3 || ^6.0.0",
    "@vitejs/plugin-vue-jsx": "^4.1.2 || ^5.0.0",
    "astro": "^5.5.3 || ^6.0.0 || ^7.0.0",
    "storybook": "^10.0.0 || ^11.0.0-beta.0",
    "storybook-solidjs-vite": ">=10.0.0 <10.1.0 || ^10.6.0 || ^11.0.0-beta.0",
    "typescript": "^5.0.0 || ^6.0.0",
    "vite": "^6.4.1 || ^7.0.0 || ^8.0.0",
    "vitest": "^4.1.0 || ^5.0.0"
  },
